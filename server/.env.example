NODE_ENV=development
PORT=4000

# MySQL 8 (dev database)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/job_management"

# Separate database used only by tests. Never point tests at the dev database.
TEST_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/job_management_test"

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
COOKIE_NAME=token

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
